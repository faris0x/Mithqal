module graphs.

use lists.
use logic.
use sets.
use relations.

export graph, directedGraph, verticesOf, edgesOf, isDirected, isUndirected, adjacency, neighbors, hasEdge, degreeOf, inDegree, outDegree, reachable, pathExists, isConnected, components, isTree, isComplete, isAcyclic, reachabilityRelation.

we define graph(vertices, edges) = [undirectedKind, setOf(vertices), setOf(map(edges, fn(edge) => sort(edge)))].

we define directedGraph(vertices, arcs) = [directedKind, setOf(vertices), setOf(arcs)].

we define verticesOf(graph) = nth(graph, 1).

we define edgesOf(graph) = nth(graph, 2).

we define isDirected(graph) = same(nth(graph, 0), directedKind).

we define isUndirected(graph) = same(nth(graph, 0), undirectedKind).

we define adjacency(graph) = relationOf(edgesOf(graph)), where isDirected(graph).

we define adjacency(graph) = let pairs = concat(map(edgesOf(graph), fn(edge) => [[nth(edge, 0), nth(edge, 1)], [nth(edge, 1), nth(edge, 0)]])) in relationOf(pairs).

we define neighbors(graph, vertex) = imageOf(adjacency(graph), [vertex]).

we define hasEdge(graph, from, to) = member(adjacency(graph), [from, to]).

we define degreeOf(graph, vertex) = length(neighbors(graph, vertex)).

we define inDegree(graph, vertex) = length(filter(edgesOf(graph), fn(edge) => same(nth(edge, 1), vertex))).

we define outDegree(graph, vertex) = degreeOf(graph, vertex).

we define walk(graph, visited, frontier) = visited, where length(frontier) == 0.

we define walk(graph, visited, frontier) = let current = first(frontier) in let remaining = rest(frontier) in if(member(visited, current), walk(graph, visited, remaining), walk(graph, union(visited, [current]), union(remaining, difference(neighbors(graph, current), visited)))).

we define reachable(graph, start) = walk(graph, [], [start]).

we define pathExists(graph, start, target) = member(reachable(graph, start), target).

we define isConnected(graph) = true, where length(verticesOf(graph)) == 0.

we define isConnected(graph) = same(length(reachable(graph, first(verticesOf(graph)))), length(verticesOf(graph))).

we define componentsFrom(graph, remaining, accumulator) = setOf(accumulator), where length(remaining) == 0.

we define componentsFrom(graph, remaining, accumulator) = let vertex = first(remaining) in let component = reachable(graph, vertex) in componentsFrom(graph, difference(remaining, component), cons(component, accumulator)).

we define components(graph) = componentsFrom(graph, verticesOf(graph), []).

we define isTree(graph) = isConnected(graph) && length(edgesOf(graph)) == length(verticesOf(graph)) - 1.

we define isComplete(graph) = let pairs = filter(cartesian(verticesOf(graph), verticesOf(graph)), fn(pair) => not(same(nth(pair, 0), nth(pair, 1)))) in allOf(pairs, fn(pair) => hasEdge(graph, nth(pair, 0), nth(pair, 1))).

we define isAcyclic(graph) = allOf(edgesOf(graph), fn(edge) => not(pathExists(graph, nth(edge, 1), nth(edge, 0)))).

we define reachabilityRelation(graph) = let pairs = concat(map(verticesOf(graph), fn(vertex) => map(reachable(graph, vertex), fn(target) => [vertex, target]))) in setOf(pairs).

end module.
