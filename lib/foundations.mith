module foundations.

use lists.
use logic.
use sets.

export peanoZero, peanoSucc, peanoAdd, peanoMul, checkPeano, vonNeumann, checkVonNeumann.

we define peanoZero() = 0.

we define peanoSucc(n) = n + 1.

we define peanoAdd(a, b) = a + b.

we define peanoMul(a, b) = a * b.

we define checkPeano(n) = let items = rangeList(n) in let injective = allOf(items, fn(a) => allOf(items, fn(b) => if(same(a, b), true, not(same(peanoSucc(a), peanoSucc(b)))))) in let additive = allOf(items, fn(a) => same(peanoAdd(a, peanoZero()), a)) in let associative = allOf(items, fn(a) => allOf(items, fn(b) => allOf(items, fn(c) => same(peanoAdd(peanoAdd(a, b), c), peanoAdd(a, peanoAdd(b, c)))))) in let distributive = allOf(items, fn(a) => allOf(items, fn(b) => same(peanoMul(a, peanoSucc(b)), peanoAdd(peanoMul(a, b), a)))) in injective && additive && associative && distributive.

we define vonNeumann(n) = undefined, where n < 0.

we define vonNeumann(n) = [], where n == 0.

we define vonNeumann(n) = let previous = vonNeumann(n - 1) in setOf(append(previous, [previous])).

we define checkVonNeumann(n) = allOf(rangeList(n + 1), fn(k) => same(length(vonNeumann(k)), k)).

end module.
