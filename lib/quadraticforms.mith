module quadraticforms.

use lists.
use numbertheory.

export binaryFormDiscriminant, isReducedBinaryForm, reduceBinaryForm, reducedForms, binaryFormClassNumber, binaryFormValue, binaryFormRepresents.

we define binaryFormDiscriminant(a, b, c) = b * b - 4 * a * c.

we define isReducedBinaryForm(a, b, c) = a > 0 && abs(b) <= a && a <= c && (b >= 0 || (abs(b) < a && a < c)).

we define reduceBinaryForm(a, b, c) = [a, b, c], where isReducedBinaryForm(a, b, c).

we define reduceBinaryForm(a, b, c) = if(a > c, reduceBinaryForm(c, -b, a), reduceStep(a, b, c)).

we define reduceStep(a, b, c) = if(b < 0 && (abs(b) == a || a == c), reduceBinaryForm(a, -b, c), reduceAdjust(a, b, c)).

we define reduceAdjust(a, b, c) = let d = binaryFormDiscriminant(a, b, c) in let adjustment = round(b / (2 * a)) in let nextB = b - 2 * a * adjustment in let nextC = (nextB * nextB - d) / (4 * a) in reduceBinaryForm(a, nextB, nextC).

we define reducedForms(d) = if(d >= 0, [], reducedFormsA(d, 1, floorSqrt(-d / 3))).

we define reducedFormsA(d, a, limit) = [], where a > limit.

we define reducedFormsA(d, a, limit) = append(reducedFormsB(d, a, -a, a), reducedFormsA(d, a + 1, limit)).

we define reducedFormsB(d, a, b, limit) = [], where b > limit.

we define reducedFormsB(d, a, b, limit) = let candidate = reducedFormCandidate(d, a, b) in append(candidate, reducedFormsB(d, a, b + 1, limit)).

we define reducedFormCandidate(d, a, b) = if(mod(b * b - d, 4 * a) != 0, [], reducedFormBuild(d, a, b, (b * b - d) / (4 * a))).

we define reducedFormBuild(d, a, b, c) = if(isReducedBinaryForm(a, b, c), [[a, b, c]], []).

we define binaryFormClassNumber(d) = length(reducedForms(d)).

we define binaryFormValue(a, b, c, x, y) = a * x * x + b * x * y + c * y * y.

we define binaryFormRepresents(n, a, b, c) = let limit = floorSqrt(abs(n)) + abs(a) + abs(c) in binaryFormRepresentsStep(n, a, b, c, -limit, limit).

we define binaryFormRepresentsStep(n, a, b, c, x, limit) = false, where x > limit.

we define binaryFormRepresentsStep(n, a, b, c, x, limit) = if(binaryFormRepresentsY(n, a, b, c, x, -limit, limit), true, binaryFormRepresentsStep(n, a, b, c, x + 1, limit)).

we define binaryFormRepresentsY(n, a, b, c, x, y, limit) = false, where y > limit.

we define binaryFormRepresentsY(n, a, b, c, x, y, limit) = if(binaryFormValue(a, b, c, x, y) == n, true, binaryFormRepresentsY(n, a, b, c, x, y + 1, limit)).

end module.
