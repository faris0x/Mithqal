module sets.

use lists.
use logic.

export setOf, emptySet, singleton, union, intersection, difference, member, subset, cardinality, isEmpty, powerSet, cartesian.

we define setOf(items) = unique(items).

we define emptySet() = [].

we define singleton(value) = [value].

we define member(items, value) = contains(items, value).

we define subset(left, right) = allOf(left, fn(item) => member(right, item)).

we define union(left, right) = setOf(append(left, right)).

we define intersection(left, right) = filter(left, fn(item) => member(right, item)).

we define difference(left, right) = filter(left, fn(item) => not(member(right, item))).

we define cardinality(items) = length(items).

we define isEmpty(items) = length(items) == 0.

we define cartesian(left, right) = let pairs = concat(map(left, fn(x) => map(right, fn(y) => [x, y]))) in setOf(pairs).

we define powerSet(items) = [[]], where length(items) == 0.

we define powerSet(items) = let item = first(items) in let restSets = powerSet(rest(items)) in setOf(append(restSets, map(restSets, fn(subset) => setOf(cons(item, subset))))).

end module.
