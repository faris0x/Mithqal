module decision.

use lists.
use logic.
use sets.
use statistics.

export expectedUtility, bestActions, decisionValue, expectedRegret, minimaxRegretActions.

we define expectedUtility(distribution, action, utility) = fold(fn(acc, pair) => acc + nth(pair, 1) * utility(action, nth(pair, 0)), 0, distribution).

we define utilities(distribution, actions, utility) = map(actions, fn(action) => [action, expectedUtility(distribution, action, utility)]).

we define decisionValue(distribution, actions, utility) = maximum(map(actions, fn(action) => expectedUtility(distribution, action, utility))).

we define bestActions(distribution, actions, utility) = let values = utilities(distribution, actions, utility) in let best = maximum(map(values, fn(pair) => nth(pair, 1))) in map(filter(values, fn(pair) => same(nth(pair, 1), best)), fn(pair) => nth(pair, 0)).

we define stateBest(actions, state, utility) = maximum(map(actions, fn(action) => utility(action, state))).

we define expectedRegret(distribution, action, actions, utility) = fold(fn(acc, pair) => acc + nth(pair, 1) * (stateBest(actions, nth(pair, 0), utility) - utility(action, nth(pair, 0))), 0, distribution).

we define minimaxRegretActions(distribution, actions, utility) = let regrets = map(actions, fn(action) => [action, expectedRegret(distribution, action, actions, utility)]) in let best = minimum(map(regrets, fn(pair) => nth(pair, 1))) in map(filter(regrets, fn(pair) => same(nth(pair, 1), best)), fn(pair) => nth(pair, 0)).

end module.
