module algebra.

use lists.

export expand, factor, together, cancel, polynomialGcd, resultant, solve, degree, coefficient, polynomialDivide, discriminant.

we define expand(expression) = kernelExpand(expression).

we define factor(expression) = kernelFactor(expression).

we define together(expression) = kernelTogether(expression).

we define cancel(expression) = kernelCancel(expression).

we define polynomialGcd(left, right, variable) = kernelPolynomialGcd(left, right, variable).

we define resultant(left, right, variable) = kernelResultant(left, right, variable).

we define solve(expression) = kernelSolve(expression).

we define solve(expression, variable) = kernelSolve(expression, variable).

we define degree(expression, variable) = kernelDegree(expression, variable).

we define coefficient(expression, variable, index) = kernelCoefficient(expression, variable, index).

we define polynomialDivide(dividend, divisor, variable) = kernelPolynomialDivide(dividend, divisor, variable).

we define discriminant(expression, variable) = kernelDiscriminant(expression, variable).

end module.
