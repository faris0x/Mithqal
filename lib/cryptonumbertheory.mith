module cryptonumbertheory.

use lists.
use logic.
use numbertheory.

export millerRabinWitness, isStrongPseudoprime, isCarmichael, isPoulet, lucasLehmer, isMersennePrimeLucasLehmer, trialDivisionFactor, rsaEncrypt, rsaDecrypt, diffieHellman, isWieferichPrime, isWilsonPrime, isEulerPseudoprime, orderOfElement.

we define millerRabinWitness(a, n) = if(n < 3 || isEven(n), false, mrWitnessStep(mod(a, n), n)).

we define mrWitnessStep(a, n) = let d = n - 1 in let s = valuation(d, 2) in let odd = d / power(2, s) in let x = powerMod(a, odd, n) in if(x == 1 || x == n - 1, false, mrWitnessLoop(x, s, n, 1)).

we define mrWitnessLoop(x, s, n, index) = true, where index >= s.

we define mrWitnessLoop(x, s, n, index) = let next = mod(x * x, n) in if(next == n - 1, false, mrWitnessLoop(next, s, n, index + 1)).

we define isStrongPseudoprime(a, n) = n > 2 && isOdd(n) && !isPrime(n) && !millerRabinWitness(a, n).

we define isCarmichael(n) = let factors = factorInteger(n) in if(length(factors) < 2, false, isCarmichaelFactors(factors, n)).

we define isCarmichaelFactors(factors, n) = if(not(all(map(factors, fn(pe) => nth(pe, 1) == 1))), false, all(map(factors, fn(pe) => divides(nth(pe, 0) - 1, n - 1)))).

we define isPoulet(n) = n > 1 && !isPrime(n) && powerMod(2, n - 1, n) == 1.

we define lucasLehmer(p) = true, where p == 2.

we define lucasLehmer(p) = let m = power(2, p) - 1 in lucasLehmerStep(4, p - 2, m).

we define lucasLehmerStep(s, count, m) = s == 0, where count <= 0.

we define lucasLehmerStep(s, count, m) = lucasLehmerStep(mod(s * s - 2, m), count - 1, m).

we define isMersennePrimeLucasLehmer(p) = isPrime(p) && lucasLehmer(p).

we define trialDivisionFactor(n) = trialDivisionStep(n, 2).

we define trialDivisionStep(n, p) = undefined, where p * p > n.

we define trialDivisionStep(n, p) = if(mod(n, p) == 0, p, trialDivisionStep(n, nextPrime(p))).

we define rsaEncrypt(message, exponent, modulus) = powerMod(message, exponent, modulus).

we define rsaDecrypt(ciphertext, exponent, modulus) = powerMod(ciphertext, exponent, modulus).

we define diffieHellman(generator, alice, bob, prime) = powerMod(generator, alice * bob, prime).

we define isWieferichPrime(p) = isPrime(p) && p > 2 && powerMod(2, p - 1, p * p) == 1.

we define isWilsonPrime(p) = isPrime(p) && mod(factorial(p - 1) + 1, p * p) == 0.

we define isEulerPseudoprime(a, n) = n > 2 && isOdd(n) && !isPrime(n) && mod(powerMod(a, (n - 1) / 2, n), n) == jacobi(a, n).

we define orderOfElement(a, n) = multiplicativeOrder(a, n).

end module.
