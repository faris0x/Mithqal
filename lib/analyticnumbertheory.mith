module analyticnumbertheory.

use lists.
use numbertheory.

export bernoulliNumber, bernoulliPolynomial, vonMangoldt, mangoldt, chebyshevTheta, chebyshevPsi, summatoryLiouville, summatoryMobius, summatoryVonMangoldt, zetaInteger, riemannZetaApprox, dirichletEta, dirichletBeta, primeZeta, eulerNumber, primeHarmonic.

we define bernoulliNumber(n) = 1, where n == 0.

we define bernoulliNumber(n) = let terms = map(rangeList(n), fn(k) => binomial(n + 1, k) * bernoulliNumber(k)) in -1 / (n + 1) * fold(fn(acc, term) => acc + term, 0, terms).

we define bernoulliPolynomial(n, x) = let terms = map(rangeList(n + 1), fn(k) => binomial(n, k) * bernoulliNumber(k) * power(x, n - k)) in fold(fn(acc, term) => acc + term, 0, terms).

we define vonMangoldt(n) = 0, where n < 2.

we define vonMangoldt(n) = let factors = factorInteger(n) in if(length(factors) == 1, ln(nth(first(factors), 0)), 0).

we define mangoldt(n) = vonMangoldt(n).

we define primesBelow(n) = filter(rangeList(n), fn(k) => isPrime(k)).

we define chebyshevTheta(n) = fold(fn(acc, p) => acc + ln(p), 0, primesBelow(n + 1)).

we define chebyshevPsi(n) = fold(fn(acc, k) => acc + vonMangoldt(k), 0, map(rangeList(n + 1), fn(k) => k)).

we define summatoryLiouville(n) = fold(fn(acc, k) => acc + liouville(k), 0, map(rangeList(n), fn(k) => k + 1)).

we define summatoryMobius(n) = mertens(n).

we define zetaInteger(s, terms) = fold(fn(acc, k) => acc + 1 / power(k, s), 0, map(rangeList(terms), fn(k) => k + 1)).

we define dirichletEta(s, terms) = fold(fn(acc, k) => acc + if(isEven(k), 1, -1) / power(k + 1, s), 0, rangeList(terms)).

we define eulerNumber(n) = 1, where n == 0.

we define eulerNumber(n) = 0, where isOdd(n).

we define eulerNumber(n) = let ks = filter(rangeList(n), fn(k) => isEven(k)) in let terms = map(ks, fn(k) => binomial(n, k) * eulerNumber(k)) in -fold(fn(acc, term) => acc + term, 0, terms).

we define summatoryVonMangoldt(n) = fold(fn(acc, k) => acc + vonMangoldt(k), 0, map(rangeList(n), fn(k) => k + 1)).

we define riemannZetaApprox(s, terms) = zetaInteger(s, terms).

we define dirichletBeta(s, terms) = fold(fn(acc, k) => acc + if(isEven(k), 1, -1) / power(2 * k + 1, s), 0, rangeList(terms)).

we define primeZeta(s, terms) = fold(fn(acc, p) => acc + 1 / power(p, s), 0, primesBelow(terms)).

we define primeHarmonic(n) = fold(fn(acc, p) => acc + 1 / p, 0, primesBelow(n + 1)).

end module.
