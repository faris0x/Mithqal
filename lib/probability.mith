module probability.

use lists.
use logic.
use sets.
use relations.
use statistics.

export distribution, isDistribution, uniform, support, probabilityOf, expectation, varianceOf, conditional, productDistribution.

we define distribution(pairs) = setOf(pairs).

we define isDistribution(distribution) = let probabilities = map(distribution, fn(pair) => nth(pair, 1)) in isFunction(distribution) && allOf(probabilities, fn(p) => isNumber(p) && p > 0) && same(total(probabilities), 1).

we define uniform(items) = let outcomes = setOf(items) in let probability = 1 / length(outcomes) in setOf(map(outcomes, fn(item) => [item, probability])).

we define support(distribution) = setOf(map(distribution, fn(pair) => nth(pair, 0))).

we define probabilityOf(distribution, event) = fold(fn(acc, pair) => if(member(event, nth(pair, 0)), acc + nth(pair, 1), acc), 0, distribution).

we define expectation(distribution, observable) = fold(fn(acc, pair) => acc + nth(pair, 1) * observable(nth(pair, 0)), 0, distribution).

we define varianceOf(distribution, observable) = expectation(distribution, fn(x) => observable(x) * observable(x)) - expectation(distribution, observable) * expectation(distribution, observable).

we define conditional(distribution, event) = let probability = probabilityOf(distribution, event) in if(same(probability, 0), undefined, setOf(map(filter(distribution, fn(pair) => member(event, nth(pair, 0))), fn(pair) => [nth(pair, 0), nth(pair, 1) / probability]))).

we define productDistribution(left, right) = let outcomes = cartesian(support(left), support(right)) in setOf(map(outcomes, fn(pair) => [pair, applyRelation(left, nth(pair, 0)) * applyRelation(right, nth(pair, 1))])).

end module.
