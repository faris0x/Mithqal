// Finite two player normal form games.
//
// A game is a list of row actions, column actions, and a set of payoff entries.
// A payoff entry is [[rowAction,colAction],[rowPayoff,colPayoff]].

mod games

import lists
import logic
import sets
import relations
import statistics

export game,rowActionsOf,colActionsOf,payoffsOf,payoff,rowPayoff,colPayoff,bestRows,bestColumns,pureNash,dominantRowActions,dominantColumnActions,paretoOptimal,isZeroSum

def game(rowActions,colActions,payoffs)=[rowActions,colActions,payoffs]
def rowActionsOf(game)=nth(game,0)
def colActionsOf(game)=nth(game,1)
def payoffsOf(game)=nth(game,2)

def payoff(game,rowAction,colAction)=applyRelation(payoffsOf(game),[rowAction,colAction])
def rowPayoff(game,row,col)=nth(payoff(game,row,col),0)
def colPayoff(game,row,col)=nth(payoff(game,row,col),1)

def bestRows(game,colAction)=
let entries=map(rowActionsOf(game),fn(row)=>[row,rowPayoff(game,row,colAction)])
let best=maximum(map(entries,fn(entry)=>nth(entry,1)))
map(filter(entries,fn(entry)=>same(nth(entry,1),best)),fn(entry)=>nth(entry,0))
end

def bestColumns(game,rowAction)=
let entries=map(colActionsOf(game),fn(column)=>[column,colPayoff(game,rowAction,column)])
let best=maximum(map(entries,fn(entry)=>nth(entry,1)))
map(filter(entries,fn(entry)=>same(nth(entry,1),best)),fn(entry)=>nth(entry,0))
end

def pureNash(game)=
let outcomes=cartesian(rowActionsOf(game),colActionsOf(game))
setOf(filter(outcomes,fn(outcome)=>member(bestRows(game,nth(outcome,1)),nth(outcome,0))&&member(bestColumns(game,nth(outcome,0)),nth(outcome,1))))
end

def dominantRowActions(game)=
filter(rowActionsOf(game),fn(row)=>allOf(colActionsOf(game),fn(column)=>member(bestRows(game,column),row)))
end

def dominantColumnActions(game)=
filter(colActionsOf(game),fn(column)=>allOf(rowActionsOf(game),fn(row)=>member(bestColumns(game,row),column)))
end

def dominates(game,other,outcome)=
let otherPayoff=payoff(game,nth(other,0),nth(other,1))
let thisPayoff=payoff(game,nth(outcome,0),nth(outcome,1))
nth(otherPayoff,0)>=nth(thisPayoff,0)&&nth(otherPayoff,1)>=nth(thisPayoff,1)&&(nth(otherPayoff,0)>nth(thisPayoff,0)||nth(otherPayoff,1)>nth(thisPayoff,1))
end

def paretoOptimal(game)=
let outcomes=cartesian(rowActionsOf(game),colActionsOf(game))
setOf(filter(outcomes,fn(outcome)=>allOf(outcomes,fn(other)=>not(dominates(game,other,outcome)))))
end

def isZeroSum(game)=
allOf(payoffsOf(game),fn(entry)=>same(nth(nth(entry,1),0)+nth(nth(entry,1),1),0))
end

end
