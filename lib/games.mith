module games.

use lists.
use logic.
use sets.
use relations.
use statistics.

export game, rowActionsOf, colActionsOf, payoffsOf, payoff, rowPayoff, colPayoff, bestRows, bestColumns, pureNash, dominantRowActions, dominantColumnActions, paretoOptimal, isZeroSum.

we define game(rowActions, colActions, payoffs) = [rowActions, colActions, payoffs].

we define rowActionsOf(game) = nth(game, 0).

we define colActionsOf(game) = nth(game, 1).

we define payoffsOf(game) = nth(game, 2).

we define payoff(game, rowAction, colAction) = applyRelation(payoffsOf(game), [rowAction, colAction]).

we define rowPayoff(game, row, col) = nth(payoff(game, row, col), 0).

we define colPayoff(game, row, col) = nth(payoff(game, row, col), 1).

we define bestRows(game, colAction) = let entries = map(rowActionsOf(game), fn(row) => [row, rowPayoff(game, row, colAction)]) in let best = maximum(map(entries, fn(entry) => nth(entry, 1))) in map(filter(entries, fn(entry) => same(nth(entry, 1), best)), fn(entry) => nth(entry, 0)).

we define bestColumns(game, rowAction) = let entries = map(colActionsOf(game), fn(column) => [column, colPayoff(game, rowAction, column)]) in let best = maximum(map(entries, fn(entry) => nth(entry, 1))) in map(filter(entries, fn(entry) => same(nth(entry, 1), best)), fn(entry) => nth(entry, 0)).

we define pureNash(game) = let outcomes = cartesian(rowActionsOf(game), colActionsOf(game)) in setOf(filter(outcomes, fn(outcome) => member(bestRows(game, nth(outcome, 1)), nth(outcome, 0)) && member(bestColumns(game, nth(outcome, 0)), nth(outcome, 1)))).

we define dominantRowActions(game) = filter(rowActionsOf(game), fn(row) => allOf(colActionsOf(game), fn(column) => member(bestRows(game, column), row))).

we define dominantColumnActions(game) = filter(colActionsOf(game), fn(column) => allOf(rowActionsOf(game), fn(row) => member(bestColumns(game, row), column))).

we define dominates(game, other, outcome) = let otherPayoff = payoff(game, nth(other, 0), nth(other, 1)) in let thisPayoff = payoff(game, nth(outcome, 0), nth(outcome, 1)) in nth(otherPayoff, 0) >= nth(thisPayoff, 0) && nth(otherPayoff, 1) >= nth(thisPayoff, 1) && (nth(otherPayoff, 0) > nth(thisPayoff, 0) || nth(otherPayoff, 1) > nth(thisPayoff, 1)).

we define paretoOptimal(game) = let outcomes = cartesian(rowActionsOf(game), colActionsOf(game)) in setOf(filter(outcomes, fn(outcome) => allOf(outcomes, fn(other) => not(dominates(game, other, outcome))))).

we define isZeroSum(game) = allOf(payoffsOf(game), fn(entry) => same(nth(nth(entry, 1), 0) + nth(nth(entry, 1), 1), 0)).

end module.
