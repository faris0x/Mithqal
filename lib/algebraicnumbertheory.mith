module algebraicnumbertheory.

use lists.
use numbertheory.
use quadraticforms.

export quadraticFieldDiscriminant, quadraticClassNumber, quadraticFundamentalUnit, quadraticRegulator, quadraticConjugate, quadraticNorm, quadraticTrace, quadraticAdd, quadraticMultiply, quadraticInverse, quadraticIsUnit, quadraticPower, eisensteinNorm, eisensteinMultiply, eisensteinIsPrime, padicValuation, padicNorm, padicUnit, padicExpansion, padicDigit.

we define quadraticFieldDiscriminant(radicand) = if(mod(radicand, 4) == 1, radicand, 4 * radicand).

we define quadraticClassNumber(radicand) = if(radicand >= 0, undefined, binaryFormClassNumber(quadraticFieldDiscriminant(radicand))).

we define quadraticFundamentalUnit(d) = undefined, where d <= 1.

we define quadraticFundamentalUnit(d) = let a0 = floorSqrt(d) in pellStep(d, 0, 1, a0, a0, 1, a0, 0, 1).

we define pellStep(d, m, den, a, a0, h0, h1, k0, k1) = if(h1 * h1 - d * k1 * k1 == 1 || h1 * h1 - d * k1 * k1 == -1, [h1, k1], pellNext(d, m, den, a, a0, h0, h1, k0, k1)).

we define pellNext(d, m, den, a, a0, h0, h1, k0, k1) = let nextM = den * a - m in let nextDen = (d - nextM * nextM) / den in let nextA = floor((a0 + nextM) / nextDen) in let nextH1 = nextA * h1 + h0 in let nextK1 = nextA * k1 + k0 in pellStep(d, nextM, nextDen, nextA, a0, h1, nextH1, k1, nextK1).

we define quadraticRegulator(d) = let unit = quadraticFundamentalUnit(d) in if(same(unit, undefined), undefined, ln(nth(unit, 0) + nth(unit, 1) * sqrt(d))).

we define quadraticConjugate(a, b) = [a, -b].

we define quadraticTrace(a, b) = 2 * a.

we define quadraticNorm(a, b, d) = a * a - d * b * b.

we define quadraticAdd(a, b, c, d) = [a + c, b + d].

we define quadraticMultiply(a, b, c, d, radicand) = [a * c + radicand * b * d, a * d + b * c].

we define quadraticInverse(a, b, d) = let norm = quadraticNorm(a, b, d) in if(norm == 0, undefined, [a / norm, -b / norm]).

we define quadraticIsUnit(a, b, d) = let norm = quadraticNorm(a, b, d) in norm == 1 || norm == -1.

we define quadraticPower(a, b, d, n) = [1, 0], where n == 0.

we define quadraticPower(a, b, d, n) = let previous = quadraticPower(a, b, d, n - 1) in quadraticMultiply(a, b, nth(previous, 0), nth(previous, 1), d).

we define eisensteinNorm(a, b) = a * a - a * b + b * b.

we define eisensteinMultiply(a, b, c, d) = [a * c - b * d, a * d + b * c - b * d].

we define eisensteinIsPrime(a, b) = let norm = eisensteinNorm(a, b) in if(isPrime(norm), mod(norm, 3) == 1, if(isPerfectSquare(norm), eisensteinPrimeSquare(norm), false)).

we define eisensteinPrimeSquare(n) = let p = floorSqrt(n) in p * p == n && isPrime(p) && mod(p, 3) == 2.

we define padicValuation(n, p) = primeExponent(n, p).

we define padicNorm(n, p) = 1 / power(p, padicValuation(n, p)).

we define padicUnit(n, p) = n / power(p, padicValuation(n, p)).

we define padicExpansion(n, p, digits) = padicExpansionStep(n, p, digits).

we define padicExpansionStep(n, p, digits) = [], where digits <= 0.

we define padicExpansionStep(n, p, digits) = cons(mod(n, p), padicExpansionStep(floor(n / p), p, digits - 1)).

we define padicDigit(n, p, k) = mod(floor(n / power(p, k)), p).

end module.
