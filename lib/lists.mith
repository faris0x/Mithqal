module lists.

export append, concat, contains, unique, filter, rangeList.

we define append(xs, ys) = ys, where length(xs) == 0.

we define append(xs, ys) = cons(first(xs), append(rest(xs), ys)).

we define concat(xss) = fold(fn(acc, xs) => append(acc, xs), [], xss).

we define contains(xs, value) = fold(fn(acc, item) => acc || same(item, value), false, xs).

we define filter(xs, predicate) = [], where length(xs) == 0.

we define filter(xs, predicate) = if(predicate(first(xs)), cons(first(xs), filter(rest(xs), predicate)), filter(rest(xs), predicate)).

we define dedupe(xs) = [], where length(xs) == 0.

we define dedupe(xs) = xs, where length(xs) == 1.

we define dedupe(xs) = dedupe(rest(xs)), where same(first(xs), first(rest(xs))).

we define dedupe(xs) = cons(first(xs), dedupe(rest(xs))).

we define unique(xs) = dedupe(sort(xs)).

we define rangeList(n) = [], where n < 1.

we define rangeList(n) = append(rangeList(n - 1), [n - 1]).

end module.
