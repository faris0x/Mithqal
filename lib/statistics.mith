module statistics.

export mean, median, minimum, maximum, range, total, count, variance, sampleVariance, standardDeviation, sampleStandardDeviation, frequency, mode.

we define numeric(xs) = length(xs) > 0 && all(map(xs, fn(x) => isNumber(x))).

we define sum(xs) = fold(fn(a, b) => a + b, 0, xs).

we define squares(xs) = fold(fn(a, b) => a + b, 0, map(xs, fn(x) => x * x)).

we define runs(xs, value, count, acc) = reverse(cons([value, count], acc)), where length(xs) == 0.

we define runs(xs, value, count, acc) = runs(rest(xs), value, count + 1, acc), where first(xs) == value.

we define runs(xs, value, count, acc) = runs(rest(xs), first(xs), 1, cons([value, count], acc)).

we define maxCount(xs, best) = best, where length(xs) == 0.

we define maxCount(xs, best) = maxCount(rest(xs), if(nth(first(xs), 1) > best, nth(first(xs), 1), best)).

we define pick(xs, best) = [], where length(xs) == 0.

we define pick(xs, best) = cons(nth(first(xs), 0), pick(rest(xs), best)), where nth(first(xs), 1) == best.

we define pick(xs, best) = pick(rest(xs), best).

we define total(xs) = sum(xs), where numeric(xs).

we define count(xs) = length(xs), where numeric(xs).

we define mean(xs) = sum(xs) / length(xs), where numeric(xs).

we define minimum(xs) = fold(fn(a, b) => if(a < b, a, b), first(xs), rest(xs)), where numeric(xs).

we define maximum(xs) = fold(fn(a, b) => if(a > b, a, b), first(xs), rest(xs)), where numeric(xs).

we define range(xs) = maximum(xs) - minimum(xs), where numeric(xs).

we define median(xs) = let ys = sort(xs) in let n = length(xs) in if(isEven(n), (nth(ys, n / 2 - 1) + nth(ys, n / 2)) / 2, nth(ys, floor(n / 2))), where numeric(xs).

we define variance(xs) = let n = length(xs) in let s = sum(xs) in let q = squares(xs) in (n * q - s * s) / (n * n), where numeric(xs).

we define sampleVariance(xs) = let n = length(xs) in let s = sum(xs) in let q = squares(xs) in (n * q - s * s) / (n * (n - 1)), where numeric(xs) && length(xs) > 1.

we define standardDeviation(xs) = sqrt(variance(xs)), where numeric(xs).

we define sampleStandardDeviation(xs) = sqrt(sampleVariance(xs)), where numeric(xs) && length(xs) > 1.

we define frequency(xs) = let ys = sort(xs) in runs(rest(ys), first(ys), 1, []), where numeric(xs).

we define mode(xs) = let fs = frequency(xs) in pick(fs, maxCount(fs, 0)), where numeric(xs).

end module.
