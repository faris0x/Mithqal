module relations.

use lists.
use logic.
use sets.

export relationOf, domainOf, rangeOf, imageOf, inverseRelation, composeRelations, isFunction, applyRelation, isReflexive, isSymmetric, isTransitive.

we define relationOf(pairs) = setOf(pairs).

we define domainOf(relation) = setOf(map(relation, fn(pair) => nth(pair, 0))).

we define rangeOf(relation) = setOf(map(relation, fn(pair) => nth(pair, 1))).

we define imageOf(relation, items) = setOf(map(filter(relation, fn(pair) => member(items, nth(pair, 0))), fn(pair) => nth(pair, 1))).

we define inverseRelation(relation) = setOf(map(relation, fn(pair) => [nth(pair, 1), nth(pair, 0)])).

we define composeRelations(first, second) = let pairs = concat(map(first, fn(pair) => map(filter(second, fn(other) => same(nth(other, 0), nth(pair, 1))), fn(other) => [nth(pair, 0), nth(other, 1)]))) in setOf(pairs).

we define isFunction(relation) = allOf(relation, fn(pair) => length(filter(relation, fn(other) => same(nth(other, 0), nth(pair, 0)))) == 1).

we define applyRelation(relation, value) = let matches = filter(relation, fn(pair) => same(nth(pair, 0), value)) in if(length(matches) == 1, nth(first(matches), 1), undefined).

we define isReflexive(relation, items) = allOf(items, fn(item) => member(relation, [item, item])).

we define isSymmetric(relation) = allOf(relation, fn(pair) => member(relation, [nth(pair, 1), nth(pair, 0)])).

we define isTransitive(relation) = allOf(relation, fn(pair) => allOf(relation, fn(other) => if(same(nth(pair, 1), nth(other, 0)), member(relation, [nth(pair, 0), nth(other, 1)]), true))).

end module.
