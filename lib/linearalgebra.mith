module linearalgebra.

use lists.
use logic.

export det, rank, transpose, inverse, rref, trace, matmul, identity, solveLinear, dot, cross, plu, charpoly, eigenvalues, nullspace, kernel, eigenvectors, qr.

we define transpose(matrix) = [], where kernelIsList(matrix) && length(matrix) == 0.

we define transpose(matrix) = let columns = length(first(matrix)) in map(rangeList(columns), fn(j) => map(matrix, fn(row) => nth(row, j))), where kernelIsList(matrix) && kernelIsList(first(matrix)).

we define transpose(matrix) = unevaluated(transpose(matrix)).

we define identity(n) = map(rangeList(n), fn(i) => map(rangeList(n), fn(j) => if(i == j, 1, 0))), where isNumber(n) && floor(n) == n && n >= 0.

we define identity(n) = unevaluated(identity(n)).

we define dot(left, right) = fold(fn(acc, i) => acc + nth(left, i) * nth(right, i), 0, rangeList(length(left))), where kernelIsList(left) && kernelIsList(right) && length(left) == length(right).

we define dot(left, right) = unevaluated(dot(left, right)).

we define cross(left, right) = [nth(left, 1) * nth(right, 2) - nth(left, 2) * nth(right, 1), nth(left, 2) * nth(right, 0) - nth(left, 0) * nth(right, 2), nth(left, 0) * nth(right, 1) - nth(left, 1) * nth(right, 0)], where kernelIsList(left) && kernelIsList(right) && length(left) == 3 && length(right) == 3.

we define cross(left, right) = unevaluated(cross(left, right)).

we define matmul(left, right) = let columns = transpose(right) in map(left, fn(row) => map(columns, fn(column) => dot(row, column))), where kernelIsList(left) && kernelIsList(right) && length(left) > 0 && length(right) > 0 && kernelIsList(first(left)) && kernelIsList(first(right)) && length(first(left)) == length(right).

we define matmul(left, right) = unevaluated(matmul(left, right)).

we define det(matrix) = kernelDet(matrix).

we define rank(matrix) = kernelRank(matrix).

we define inverse(matrix) = kernelInverse(matrix).

we define rref(matrix) = kernelRref(matrix).

we define solveLinear(matrix, rhs) = kernelSolveLinear(matrix, rhs).

we define plu(matrix) = kernelPlu(matrix).

we define charpoly(matrix) = kernelCharpoly(matrix).

we define eigenvalues(matrix) = kernelEigenvalues(matrix).

we define nullspace(matrix) = kernelNullspace(matrix).

we define kernel(matrix) = kernelNullspace(matrix).

we define eigenvectors(matrix) = kernelEigenvectors(matrix).

we define qr(matrix) = kernelQr(matrix).

we define trace(matrix) = fold(fn(acc, i) => acc + nth(nth(matrix, i), i), 0, rangeList(length(matrix))), where kernelIsList(matrix) && length(matrix) > 0 && kernelIsList(first(matrix)) && length(first(matrix)) == length(matrix).

we define trace(matrix) = unevaluated(trace(matrix)).

end module.
